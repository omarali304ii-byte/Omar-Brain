filters:
  and:
    - 'type == "episode"'
properties:
  status:
    displayName: Status
  episode_id:
    displayName: Episode
  run_id:
    displayName: Run
  started_at:
    displayName: Started
  human_feedback:
    displayName: Feedback
views:
  - type: table
    name: Episodes
    order:
      - file.name
      - status
      - episode_id
      - run_id
      - started_at
      - human_feedback
