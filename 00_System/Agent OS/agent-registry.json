      "memory_access": "read; may write own project council cognition; global durable memory propose only",
      "may_commit_memory": false,
      "human_approval": [],
      "stop_condition": "owned task proven or explicit blocker/unknown recorded; own current cognition reconciled; NEXT_START updated",
      "capabilities": [
        "system boundaries",
        "module ownership",
        "layering",
        "coupling",
        "architecture drift",
        "persistent-project-cognition",
        "failure-immunity",
        "exact-restart"
