{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Omar Brain Agent Loop Runtime State",
  "type": "object",
  "required": [
    "loop_version",
    "loop_status",
    "project_id",
    "plan_id",
    "batch_states"
  ],
  "properties": {
    "loop_version": {
      "type": "string"
    },
    "loop_status": {
      "enum": [
        "ACTIVE",
        "BLOCKED",
        "COMPLETE",
        "PAUSED"
      ]
    },
    "project_id": {
      "type": "string"
    },
    "plan_id": {
      "type": "string"
    },
    "current_batch": {
      "type": [
        "string",
        "null"
      ]
    },
    "batch_states": {
      "type": "object"
    }
  }
}
