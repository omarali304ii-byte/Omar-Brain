{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Omar Brain Batch Contract",
  "type": "object",
  "required": [
    "batch_id",
    "title",
    "objective",
    "depends_on",
    "acceptance_criteria",
    "verification"
  ],
  "properties": {
    "batch_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "objective": {
      "type": "string"
    },
    "depends_on": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "required": {
      "type": "boolean"
    },
    "skippable": {
      "type": "boolean"
    },
    "read_first": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "relevant_files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "acceptance_criteria": {
      "type": "array"
    },
    "verification": {
      "type": "array"
    }
  }
}
