{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Omar Brain Agentic Plan Spec",
  "type": "object",
  "required": [
    "project",
    "final_goal",
    "batches"
  ],
  "properties": {
    "plan_version": {
      "type": "string"
    },
    "project": {
      "type": "object",
      "required": [
        "project_id",
        "title"
      ],
      "properties": {
        "project_id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "repo_path": {
          "type": "string"
        }
      }
    },
    "final_goal": {
      "type": "object",
      "required": [
        "goal_id",
        "objective",
        "success_criteria"
      ],
      "properties": {
        "goal_id": {
          "type": "string"
        },
        "objective": {
          "type": "string"
        },
        "success_criteria": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "verification": {
          "type": "array"
        }
      }
    },
    "policy": {
      "type": "object"
    },
    "batches": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "objective"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "objective": {
            "type": "string"
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "required": {
            "type": "boolean"
          },
          "skippable": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
